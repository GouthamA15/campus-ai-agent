    {
      "chunk_id": "MTech-dc-info.php.json_chunk_2",
      "chunk_index": 2,
      "heading": "Electronics:",
      "heading_level": 2,
      "chunk_type": "paragraph",
      "text": "Electronics:\nFocusing on the design and functioning of electronic devices and circuits, including analog and digital systems, semiconductors, transistors, microprocessors, and microcontrollers.",
      "token_count": 29
    },
    {
      "chunk_id": "MTech-dc-info.php.json_chunk_3",
      "chunk_index": 3,
      "heading": "Communication Systems:",
      "heading_level": 2,
      "chunk_type": "paragraph",
      "text": "Communication Systems:\nEmphasizing the principles of data transmission and communication networks, with topics such as wireless communication, satellite systems, fiber optics, and network protocols.",
      "token_count": 30
    },
    {
      "chunk_id": "MTech-dc-info.php.json_chunk_4",
      "chunk_index": 4,
      "heading": "Signal Processing:",
      "heading_level": 2,
      "chunk_type": "paragraph",
      "text": "Signal Processing:\nTeaching students to analyze and interpret various types of signals (e.g., audio, video, digital data) for applications like image processing, audio enhancement, and speech recognition.\nThe ECE department aims to prepare students for careers in rapidly evolving technology fields, from telecommunications and broadcasting to embedded systems and IoT (Internet of Things).\nFaculty of DC",
      "token_count": 72
    },
