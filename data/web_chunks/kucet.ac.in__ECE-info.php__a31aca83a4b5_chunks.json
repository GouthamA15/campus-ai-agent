    {
      "chunk_id": "ECE-info.php.json_chunk_54",
      "chunk_index": 54,
      "heading": "Electronic Devices and Circuits Lab:",
      "heading_level": 2,
      "chunk_type": "paragraph",
      "text": "Electronic Devices and Circuits Lab:\nThis lab introduces students to the fundamentals of electronic components and circuits.\nEquipped with oscilloscopes, function generators, and multimeters, students design and analyze various analog circuits, gaining insights into their real-world applications.",
      "token_count": 46
    },
    {
      "chunk_id": "ECE-info.php.json_chunk_55",
      "chunk_index": 55,
      "heading": "Digital Electronics Lab:",
      "heading_level": 2,
      "chunk_type": "paragraph",
      "text": "Digital Electronics Lab:\nFocusing on the principles of digital systems, this lab allows students to work with logic gates, flip-flops, counters, and multiplexers.\nThrough practical experiments, students understand the design and functioning of digital circuits.",
      "token_count": 45
    },
    {
      "chunk_id": "ECE-info.php.json_chunk_56",
      "chunk_index": 56,
      "heading": "Microprocessors and Microcontrollers Lab:",
      "heading_level": 2,
      "chunk_type": "paragraph",
      "text": "Microprocessors and Microcontrollers Lab:\nThis lab provides an in-depth understanding of microprocessor and microcontroller architectures.\nStudents engage in programming exercises, interfacing peripherals, and developing embedded systems, laying the foundation for advanced applications in automation and control.",
      "token_count": 44
    },
    {
      "chunk_id": "ECE-info.php.json_chunk_57",
      "chunk_index": 57,
      "heading": "Analog and Digital Communication Lab:",
      "heading_level": 2,
      "chunk_type": "paragraph",
      "text": "Analog and Digital Communication Lab:\nStudents explore the concepts of modulation, demodulation, and signal transmission in this lab.  Using various trainer kits and simulation tools, they analyze the performance of communication systems, both analog and digital.",
      "token_count": 43
    },
    {
      "chunk_id": "ECE-info.php.json_chunk_58",
      "chunk_index": 58,
      "heading": "Digital Signal Processing Lab:",
      "heading_level": 2,
      "chunk_type": "paragraph",
      "text": "Digital Signal Processing Lab:\nThis lab emphasizes the processing of signals using digital techniques.\nStudents utilize software tools like MATLAB to perform operations such as filtering, Fourier analysis, and convolution, enhancing their analytical skills.",
      "token_count": 40
    },
    {
      "chunk_id": "ECE-info.php.json_chunk_59",
      "chunk_index": 59,
      "heading": "VLSI Design Lab:",
      "heading_level": 2,
      "chunk_type": "paragraph",
      "text": "VLSI Design Lab:\nFocusing on Very Large Scale Integration (VLSI) technology, this lab introduces students to the design and simulation of integrated circuits.\nUsing industry-standard software, they develop and test complex digital systems.",
      "token_count": 42
    },
    {
      "chunk_id": "ECE-info.php.json_chunk_60",
      "chunk_index": 60,
      "heading": "Embedded Systems Lab:",
      "heading_level": 2,
      "chunk_type": "paragraph",
      "text": "Embedded Systems Lab:\nThis lab offers insights into the design and implementation of embedded systems.\nStudents work on real-time applications, interfacing sensors and actuators, and developing firmware, preparing them for challenges in the IoT and automation sectors.",
      "token_count": 45
    },
    {
      "chunk_id": "ECE-info.php.json_chunk_61",
      "chunk_index": 61,
      "heading": "Microwave and Optical Communication Lab:",
      "heading_level": 2,
      "chunk_type": "paragraph",
      "text": "Microwave and Optical Communication Lab:\nStudents delve into high-frequency communication systems in this lab.\nExperiments include studying microwave components, waveguides, and optical fibers, providing a comprehensive understanding of advanced communication technologies.",
      "token_count": 39
    },
    {
      "chunk_id": "ECE-info.php.json_chunk_62",
      "chunk_index": 62,
      "heading": "Analog Electronics Lab:",
      "heading_level": 2,
      "chunk_type": "paragraph",
      "text": "Analog Electronics Lab:\nThe Analog Electronics Lab is designed to provide students with practical, hands-on experience in the design, analysis, and testing of analog electronic circuits.\nThis lab complements theoretical coursework by allowing students to implement and verify the behavior of various analog components and systems.\nStudents will work with components such as resistors, capacitors, diodes, transistors (BJT and MOSFET), and operational amplifiers.\nThey will gain proficiency in using essential electronic instruments such as oscilloscopes, function generators, multimeters, and regulated power supplies.",
      "token_count": 101
    }
  ]
